# Copy to .env and fill in real values. Never commit .env.

# Server
PORT=5000
LOG_LEVEL=info

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/api-monitor

# Used only by `npm run seed`. Point at a local or throwaway DB, never your real one.
SEED_MONGO_URI=mongodb://127.0.0.1:27017/api-monitor-demo

# Redis (BullMQ queue + health check). Use rediss:// for TLS providers such as Upstash.
REDIS_URL=redis://127.0.0.1:6379

# Auth (use long random strings, e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

# SMTP (email alert action)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="API Monitor <no-reply@example.com>"

# AI incident analysis (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=
# Master switch for the AI analysis feature. Must be exactly "true" to turn it on.
AI_ANALYSIS_ENABLED=false
AI_DAILY_LIMIT=30

# --- Cookies / CORS ---
# Mark the refresh cookie Secure (automatic when NODE_ENV=production).
COOKIE_SECURE=false
# Set to "none" ONLY if the frontend and API are on different sites (forces Secure).
# If you do, also set CORS_ORIGINS below.
COOKIE_SAMESITE=
# Comma-separated list of allowed browser origins. Empty = reflect any origin (dev only).
CORS_ORIGINS=

# --- Alerts ---
# Webhook/Slack/Teams targets that resolve to private/internal addresses are blocked
# (SSRF protection). Set to true ONLY for local testing against http://localhost.
ALLOW_PRIVATE_WEBHOOK_TARGETS=false

# --- Scheduling ---
# On startup, re-create any missing check schedules in Redis. Set false to skip
# (e.g. when pointing at a demo/seed database whose monitors use fake URLs).
SYNC_MONITOR_JOBS=true
